
pipeline {
    agent any

    environment {
        APP_DIR = 'Exercise-09-Jenkins-MultiStage-Pipeline/python-flask-app'
        VENV = "${WORKSPACE}/.venv"
        DEPLOY_DIR = "${WORKSPACE}/python-app-deploy"
    }

    stages {
        stage('Build') {
            steps {
                echo 'Creating virtual environment and installing dependencies...'
                sh '''
                    python3 -m venv "$VENV"
                    "$VENV/bin/python" -m pip install --upgrade pip
                    "$VENV/bin/pip" install -r "$APP_DIR/requirements.txt"
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                sh '''
                    cd "$APP_DIR"
                    "$VENV/bin/python" -m unittest discover -s . -v
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application to the mock deployment directory...'
                sh '''
                    mkdir -p "$DEPLOY_DIR"
                    cp "$APP_DIR/app.py" "$DEPLOY_DIR/"
                    cp "$APP_DIR/requirements.txt" "$DEPLOY_DIR/"
                    test -f "$DEPLOY_DIR/app.py"
                    echo "Application copied to $DEPLOY_DIR"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting Flask application...'
                sh '''
                    mkdir -p "$DEPLOY_DIR"

                    nohup "$VENV/bin/python" "$DEPLOY_DIR/app.py" \
                        > "$DEPLOY_DIR/app.log" 2>&1 &
                    echo $! > "$DEPLOY_DIR/app.pid"

                    for i in $(seq 1 20); do
                        if curl --silent --fail \
                            http://127.0.0.1:5000/ \
                            > "$DEPLOY_DIR/response.txt"; then
                            break
                        fi
                        sleep 1
                    done

                    cat "$DEPLOY_DIR/app.log"
                    test -s "$DEPLOY_DIR/response.txt"
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Checking the running application...'
                sh '''
                    RESPONSE=$(curl --silent --show-error --fail \
                        http://127.0.0.1:5000/)

                    echo "Application response: $RESPONSE"

                    test "$RESPONSE" = \
                        "Hello, Jenkins Multi-Stage Pipeline!"
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the console output.'
        }

        always {
            sh '''
                if [ -f "$DEPLOY_DIR/app.pid" ]; then
                    kill "$(cat "$DEPLOY_DIR/app.pid")" 2>/dev/null || true
                fi
            '''
        }
    }
}
